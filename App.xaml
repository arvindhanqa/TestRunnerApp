<Application x:Class="TestRunnerApp.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="NavBg" Color="#FF007ACC" />
        <SolidColorBrush x:Key="BgPage" Color="#FFF5F7F8" />
        <SolidColorBrush x:Key="Bdr" Color="#FFD2D4D7" />
        <SolidColorBrush x:Key="BdrFocus" Color="#FF007ACC" />
        <SolidColorBrush x:Key="Fg" Color="#FF333333" />
        <SolidColorBrush x:Key="Fg2" Color="#FF666666" />
        <SolidColorBrush x:Key="Fg3" Color="#FF999999" />
        <SolidColorBrush x:Key="Acc" Color="#FF007ACC" />
        <SolidColorBrush x:Key="AccHover" Color="#FF005FA3" />
        <SolidColorBrush x:Key="AccLight" Color="#FFB5D7EF" />
        <SolidColorBrush x:Key="Err" Color="#FFE53935" />
        <SolidColorBrush x:Key="Ok" Color="#FF28A745" />
        <SolidColorBrush x:Key="Warn" Color="#FFFFC107" />

        <Style TargetType="Window">
            <Setter Property="FontFamily" Value="Arial, Helvetica Neue, Helvetica, sans-serif" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <!-- TextBox: thin box border, blue on focus (like Acumatica Description field) -->
        <Style x:Key="TB" TargetType="TextBox">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="{StaticResource Fg}" />
            <Setter Property="BorderBrush" Value="#FFD2D4D7" />
            <Setter Property="BorderThickness" Value="0.75" />
            <Setter Property="Padding" Value="5,4" />
            <Setter Property="FontFamily" Value="Arial" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="CaretBrush" Value="{StaticResource Acc}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2">
                            <ScrollViewer x:Name="PART_ContentHost" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource BdrFocus}" />
                                <Setter TargetName="bd" Property="BorderThickness" Value="1.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CB" TargetType="ComboBox">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="{StaticResource Fg}" />
            <Setter Property="BorderBrush" Value="#FFD2D4D7" />
            <Setter Property="BorderThickness" Value="0.75" />
            <Setter Property="Padding" Value="5,4" />
            <Setter Property="FontFamily" Value="Arial" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Padding" Value="8,5" /><Setter Property="FontFamily" Value="Arial" />
                        <Style.Triggers>
                            <Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="{StaticResource AccLight}" /></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{StaticResource AccLight}" /><Setter Property="Foreground" Value="{StaticResource Acc}" /><Setter Property="FontWeight" Value="SemiBold" /></Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnP" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Acc}" /><Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" /><Setter Property="Padding" Value="16,7" />
            <Setter Property="FontFamily" Value="Arial" /><Setter Property="FontSize" Value="13" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="2" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="{StaticResource AccHover}" /></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="bd" Property="Opacity" Value="0.5" /></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>

        <Style x:Key="BtnS" TargetType="Button">
            <Setter Property="Background" Value="White" /><Setter Property="Foreground" Value="{StaticResource Fg2}" />
            <Setter Property="BorderBrush" Value="#FFD2D4D7" /><Setter Property="BorderThickness" Value="0.75" />
            <Setter Property="Padding" Value="10,5" /><Setter Property="FontFamily" Value="Arial" /><Setter Property="FontSize" Value="12" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#FFF0F0F0" /></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>

        <Style x:Key="TC" TargetType="TabControl"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /></Style>
        <Style x:Key="TI" TargetType="TabItem">
            <Setter Property="FontFamily" Value="Arial" /><Setter Property="FontSize" Value="12" /><Setter Property="Foreground" Value="{StaticResource Fg2}" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
                <Border x:Name="tb" Padding="14,10" Cursor="Hand" BorderThickness="0,0,0,2" BorderBrush="Transparent" Background="Transparent">
                    <ContentPresenter ContentSource="Header" /></Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="tb" Property="BorderBrush" Value="{StaticResource Acc}" /><Setter Property="Foreground" Value="{StaticResource Acc}" /></Trigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{StaticResource Fg}" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>

        <Style x:Key="Tog" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
                <Border x:Name="tr" Width="34" Height="18" CornerRadius="9" Background="#FFD2D4D7">
                    <Border x:Name="th" Width="14" Height="14" CornerRadius="7" HorizontalAlignment="Left" Margin="2,0,0,0" Background="White">
                        <Border.Effect><DropShadowEffect ShadowDepth="1" BlurRadius="2" Opacity="0.15" /></Border.Effect></Border></Border>
                <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="tr" Property="Background" Value="{StaticResource Acc}" /><Setter TargetName="th" Property="HorizontalAlignment" Value="Right" /><Setter TargetName="th" Property="Margin" Value="0,0,2,0" /></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White" /><Setter Property="BorderBrush" Value="#FFE0E0E0" />
            <Setter Property="BorderThickness" Value="0.75" /><Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="20,16" /><Setter Property="VerticalAlignment" Value="Stretch" />
        </Style>
        <Style x:Key="Lbl" TargetType="TextBlock"><Setter Property="FontSize" Value="12" /><Setter Property="Foreground" Value="{StaticResource Fg2}" /><Setter Property="FontFamily" Value="Arial" /><Setter Property="Margin" Value="0,0,0,3" /></Style>
        <Style x:Key="Hdr" TargetType="TextBlock"><Setter Property="FontSize" Value="14" /><Setter Property="FontWeight" Value="Bold" /><Setter Property="Foreground" Value="{StaticResource Fg}" /><Setter Property="FontFamily" Value="Arial" /><Setter Property="Margin" Value="0,0,0,12" /></Style>
    </Application.Resources>
</Application>
