<UserControl x:Class="TestRunnerApp.BreakpointTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TestRunnerApp">

    <UserControl.Resources>
        <Style x:Key="NodeItemStyle" TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="True"/>
            <Setter Property="Padding"    Value="2,2"/>
        </Style>

        <HierarchicalDataTemplate x:Key="NodeTemplate" ItemsSource="{Binding Children}">
            <TextBlock Text="{Binding DisplayName}" FontSize="12" Margin="2,1"/>
        </HierarchicalDataTemplate>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- ROW 0: Build section -->
            <RowDefinition Height="Auto"/>
            <!-- ROW 1: File picker -->
            <RowDefinition Height="Auto"/>
            <!-- ROW 2: Toolbar -->
            <RowDefinition Height="*"/>
            <!-- ROW 3: Tree + build output -->
            <RowDefinition Height="Auto"/>
            <!-- ROW 4: Pause banner -->
            <RowDefinition Height="Auto"/>
            <!-- ROW 5: Checkpoint banner -->
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════════════════════════════
             ROW 0 — TestProject Build
        ══════════════════════════════════════════════════════════════ -->
        <GroupBox Grid.Row="0" Header="TestProject Build" Margin="0,0,0,6" Padding="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text=".sln / .csproj:"
                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox   x:Name="TxtSlnPath" Grid.Column="1"
                               VerticalContentAlignment="Center"
                               FontFamily="Consolas" FontSize="11"
                               Height="26" Margin="0,0,4,0" IsReadOnly="True"/>
                    <Button    x:Name="BtnBrowseSln" Grid.Column="2"
                               Content="Browse…" Width="75" Height="26"
                               Click="BtnBrowseSln_Click"/>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button      x:Name="BtnBuild" Grid.Column="0"
                                 Content="🔨  Build" Width="100" Height="28"
                                 Margin="0,0,6,0" IsEnabled="False"
                                 Click="BtnBuild_Click"
                                 ToolTip="Run msbuild on the selected solution/project"/>
                    <ComboBox    x:Name="CmbConfiguration" Grid.Column="1"
                                 Width="90" Height="26" Margin="0,0,6,0"
                                 VerticalContentAlignment="Center" SelectedIndex="0">
                        <ComboBoxItem Content="Debug"/>
                        <ComboBoxItem Content="Release"/>
                    </ComboBox>
                    <Button      x:Name="BtnToggleBuildOutput" Grid.Column="2"
                                 Content="▼ Output" Width="80" Height="26"
                                 Margin="0,0,6,0" Click="BtnToggleBuildOutput_Click"/>
                    <TextBlock   x:Name="TxtBuildStatus" Grid.Column="3"
                                 VerticalAlignment="Center" FontStyle="Italic"
                                 Foreground="#666" Text="No build run yet"/>
                    <ProgressBar x:Name="BuildProgress" Grid.Column="4"
                                 Width="80" Height="14" IsIndeterminate="True"
                                 Visibility="Collapsed" Margin="4,0,0,0"/>
                </Grid>
            </Grid>
        </GroupBox>

        <!-- ══════════════════════════════════════════════════════════════
             ROW 1 — Test Source File
        ══════════════════════════════════════════════════════════════ -->
        <GroupBox Grid.Row="1" Header="Test Source File" Margin="0,0,0,6" Padding="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox  x:Name="TxtFilePath" Grid.Column="0"
                          VerticalContentAlignment="Center"
                          FontFamily="Consolas" FontSize="11"
                          Height="26" Margin="0,0,4,0" IsReadOnly="True"/>
                <Button   x:Name="BtnBrowse" Grid.Column="1"
                          Content="Browse…" Width="75" Height="26"
                          Margin="0,0,4,0" Click="BtnBrowse_Click"/>
                <Button   x:Name="BtnReload" Grid.Column="2"
                          Content="↺ Reload" Width="70" Height="26"
                          Click="BtnReload_Click"
                          ToolTip="Re-parse the file (use after editing)"/>
            </Grid>
        </GroupBox>

        <!-- ══════════════════════════════════════════════════════════════
             ROW 2 — Action Toolbar
        ══════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="2" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <!-- mode selector -->
                <ColumnDefinition Width="20"/>
                <!-- spacer -->
                <ColumnDefinition Width="Auto"/>
                <!-- set breakpoint -->
                <ColumnDefinition Width="Auto"/>
                <!-- clear all -->
                <ColumnDefinition Width="*"/>
                <!-- status text -->
            </Grid.ColumnDefinitions>

            <!-- Breakpoint mode selector -->
            <Border Grid.Column="0"
                    BorderBrush="#CCC" BorderThickness="1"
                    CornerRadius="3" Padding="6,4">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Mode:" VerticalAlignment="Center"
                               Margin="0,0,8,0" FontWeight="SemiBold"/>
                    <RadioButton x:Name="RboPause"
                                 Content="⏸  Pause"
                                 IsChecked="True"
                                 VerticalAlignment="Center"
                                 Margin="0,0,12,0"
                                 ToolTip="Pause test execution and wait for manual Resume"/>
                    <RadioButton x:Name="RboCheckpoint"
                                 Content="🔖  Checkpoint"
                                 VerticalAlignment="Center"
                                 ToolTip="Stop test, save DB copy, restore DB, auto-start next test"/>
                </StackPanel>
            </Border>

            <Button x:Name="BtnSetBreakpoint" Grid.Column="2"
                    Content="Set Breakpoint"
                    Width="130" Height="28"
                    Margin="0,0,6,0" IsEnabled="False"
                    Click="BtnSetBreakpoint_Click"/>

            <Button x:Name="BtnClearAll" Grid.Column="3"
                    Content="✖  Clear All"
                    Width="100" Height="28"
                    Margin="0,0,8,0" IsEnabled="False"
                    Click="BtnClearAll_Click"
                    ToolTip="Remove all injected breakpoints from the file"/>

            <TextBlock x:Name="TxtBreakpointStatus" Grid.Column="4"
                       VerticalAlignment="Center"
                       FontStyle="Italic" Foreground="#666"
                       Text="No breakpoint set"/>
        </Grid>

        <!-- ══════════════════════════════════════════════════════════════
             ROW 3 — Test Tree + Build Output (splitter)
        ══════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="4"/>
                <RowDefinition x:Name="BuildOutputRow" Height="0"/>
            </Grid.RowDefinitions>

            <!-- Test tree -->
            <GroupBox Grid.Row="0" Header="Test Structure" Padding="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
                        <Button Content="Expand All"   Width="80" Height="22"
                                Margin="0,0,4,0" Click="BtnExpandAll_Click"/>
                        <Button Content="Collapse All" Width="80" Height="22"
                                Click="BtnCollapseAll_Click"/>
                        <TextBlock x:Name="TxtNodeHint" VerticalAlignment="Center"
                                   Margin="12,0,0,0" FontStyle="Italic" Foreground="#888"
                                   Text="Select a step or case, then set a breakpoint"/>
                    </StackPanel>
                    <TreeView x:Name="TestTree" Grid.Row="1"
                              ItemTemplate="{StaticResource NodeTemplate}"
                              ItemContainerStyle="{StaticResource NodeItemStyle}"
                              SelectedItemChanged="TestTree_SelectedItemChanged"
                              BorderBrush="#CCC" FontFamily="Segoe UI" FontSize="12"/>

                </Grid>
            </GroupBox>

            <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch"
                          Background="#CCC" ShowsPreview="True"/>

            <!-- Build output -->
            <GroupBox Grid.Row="2" Header="Build Output" Padding="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBox x:Name="TxtBuildOutput" Grid.Row="0"
                             IsReadOnly="True" TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             FontFamily="Consolas" FontSize="11"
                             Background="#1E1E1E" Foreground="#D4D4D4"
                             BorderThickness="0" Padding="6"/>
                    <Button x:Name="BtnClearBuildOutput" Grid.Row="1"
                            Content="Clear" Width="60" Height="22"
                            HorizontalAlignment="Right" Margin="0,4,0,0"
                            Click="BtnClearBuildOutput_Click"/>
                </Grid>
            </GroupBox>
        </Grid>

        <!-- ══════════════════════════════════════════════════════════════
             ROW 4 — Pause / Resume Banner
        ══════════════════════════════════════════════════════════════ -->
        <Border x:Name="PauseBanner" Grid.Row="4"
                Background="#FFF3CD" BorderBrush="#FFC107"
                BorderThickness="1" CornerRadius="4"
                Margin="0,6,0,0" Padding="10,6"
                Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⏸ " FontSize="18" VerticalAlignment="Center"/>
                    <TextBlock VerticalAlignment="Center" FontSize="13">
                        <Run Text="Paused at: "/>
                        <Run x:Name="RunPausedAt" FontWeight="Bold"/>
                    </TextBlock>
                    <TextBlock Text="   — browser and DB are live. Inspect, then resume."
                               VerticalAlignment="Center" Foreground="#666" FontSize="12"/>
                </StackPanel>
                <Button x:Name="BtnResume" Grid.Column="1"
                        Content="▶  Resume" Width="100" Height="30"
                        Background="#28A745" Foreground="White" FontWeight="Bold"
                        Click="BtnResume_Click"/>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════════════════
             ROW 5 — Checkpoint Activity Banner
        ══════════════════════════════════════════════════════════════ -->
        <Border x:Name="CheckpointBanner" Grid.Row="5"
                Background="#D1ECF1" BorderBrush="#17A2B8"
                BorderThickness="1" CornerRadius="4"
                Margin="0,4,0,0" Padding="10,6"
                Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="🔖 " FontSize="18" VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtCheckpointStep"
                               FontWeight="Bold" FontSize="13"/>
                    <TextBlock x:Name="TxtCheckpointActivity"
                               FontSize="11" Foreground="#555"
                               Margin="0,2,0,0"/>
                </StackPanel>

                <ProgressBar x:Name="CheckpointProgress"
                             Grid.Column="2"
                             Width="120" Height="14"
                             IsIndeterminate="True"
                             Margin="10,0,0,0"/>
            </Grid>
        </Border>

    </Grid>
</UserControl>
