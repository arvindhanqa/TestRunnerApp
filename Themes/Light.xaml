<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Navigation -->
    <SolidColorBrush x:Key="NavBg"       Color="#FF007ACC" />
    <!-- Backgrounds -->
    <SolidColorBrush x:Key="BgPage"      Color="#FFF5F7F8" />
    <SolidColorBrush x:Key="CardBg"      Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="InputBg"     Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="BtnSBg"      Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="DropDownBg"  Color="#FFFFFFFF" />
    <!-- Borders -->
    <SolidColorBrush x:Key="Bdr"         Color="#FFD2D4D7" />
    <SolidColorBrush x:Key="BdrFocus"    Color="#FF007ACC" />
    <SolidColorBrush x:Key="CardBdr"     Color="#FFE0E0E0" />
    <SolidColorBrush x:Key="DropDownBdr" Color="#FFD2D4D7" />
    <!-- Text -->
    <SolidColorBrush x:Key="Fg"          Color="#FF333333" />
    <SolidColorBrush x:Key="Fg2"         Color="#FF666666" />
    <SolidColorBrush x:Key="Fg3"         Color="#FF999999" />
    <!-- Interactive -->
    <SolidColorBrush x:Key="BtnSHover"   Color="#FFF0F0F0" />
    <SolidColorBrush x:Key="TogTrackOff" Color="#FFD2D4D7" />
</ResourceDictionary>
