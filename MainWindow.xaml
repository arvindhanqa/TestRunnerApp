<Window x:Class="TestRunnerApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TestRunnerApp"
        Title="Local Test Portal" Width="1200" Height="800" MinWidth="900" MinHeight="600"
        Background="{DynamicResource BgPage}" WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Background="{DynamicResource NavBg}" Padding="20,8">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="portal-logo.png"
                           Width="28" Height="28"
                           Margin="0,0,10,0"
                           VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="Local Test Portal"
                               FontSize="15" Foreground="White"
                               VerticalAlignment="Center" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="btnTheme" Content="🌙"
                            Style="{StaticResource BtnS}"
                            Margin="0,0,8,0" Padding="8,4" FontSize="14"
                            Click="BtnTheme_Click"
                            ToolTip="Toggle dark / light theme" />
                    <TextBlock x:Name="txtBadge" Text="0 tests selected" FontSize="12" Foreground="#FFAEC6E0" VerticalAlignment="Center" Margin="0,0,20,0" />
                    <Button x:Name="btnRun" Content="Run Tests" Style="{StaticResource BtnP}" Click="BtnRun_Click" />
                    <Button x:Name="btnStop" Content="Stop" Style="{StaticResource BtnS}" Click="BtnStop_Click" Visibility="Collapsed" Margin="8,0,0,0" Foreground="{StaticResource Err}" BorderBrush="{StaticResource Err}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- GLOBAL BANNERS (visible on all tabs) -->
        <StackPanel Grid.Row="1" Margin="20,0,20,0">
            <!-- Breakpoint Active Indicator -->
            <Border x:Name="GlobalBreakpointBar"
                    Background="#FCE4EC" BorderBrush="#E53935"
                    BorderThickness="1" CornerRadius="4"
                    Margin="0,6,0,0" Padding="10,5"
                    Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="GlobalBreakpointIcon" Text="🔴" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock x:Name="GlobalBreakpointText" Text="Pause breakpoint active — rebuild before running"
                               FontSize="12" FontWeight="SemiBold" Foreground="#C62828" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Pause / Resume Banner -->
            <Border x:Name="GlobalPauseBanner"
                    Background="#FFF3CD" BorderBrush="#FFC107"
                    BorderThickness="1" CornerRadius="4"
                    Margin="0,6,0,0" Padding="10,6"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="⏸ " FontSize="18" VerticalAlignment="Center"/>
                        <TextBlock VerticalAlignment="Center" FontSize="13">
                            <Run Text="Paused at: " Foreground="#333"/>
                            <Run x:Name="GlobalPausedAt" FontWeight="Bold" Foreground="#333"/>
                        </TextBlock>
                        <TextBlock Text="   — browser and DB are live. Inspect, then resume."
                                   VerticalAlignment="Center" Foreground="#666" FontSize="12"/>
                    </StackPanel>
                    <Button x:Name="btnGlobalResume" Grid.Column="1"
                            Content="▶  Resume" Width="100" Height="30"
                            Background="#28A745" Foreground="White" FontWeight="Bold"
                            Click="BtnGlobalResume_Click"/>
                </Grid>
            </Border>

            <!-- Checkpoint Activity Banner -->
            <Border x:Name="GlobalCheckpointBanner"
                    Background="#D1ECF1" BorderBrush="#17A2B8"
                    BorderThickness="1" CornerRadius="4"
                    Margin="0,4,0,0" Padding="10,6"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="🔖 " FontSize="18" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="GlobalCheckpointStep" FontWeight="Bold" FontSize="13" Foreground="#333"/>
                        <TextBlock x:Name="GlobalCheckpointActivity" FontSize="11" Foreground="#555" Margin="0,2,0,0"/>
                    </StackPanel>
                    <ProgressBar x:Name="GlobalCheckpointProgress"
                                 Grid.Column="2" Width="120" Height="14"
                                 IsIndeterminate="True" Margin="10,0,0,0"/>
                </Grid>
            </Border>
        </StackPanel>

        <TabControl x:Name="tabs" Grid.Row="2" Style="{StaticResource TC}" Padding="20,0" Background="{DynamicResource BgPage}">

            <!-- ═══════════════ CONFIGURATION ═══════════════ -->
            <TabItem Header="CONFIGURATION" Style="{StaticResource TI}">
                <Grid Margin="20,14,20,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Site Connection Card -->
                    <Border Grid.Column="0" Grid.Row="0" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Hdr}" Text="Site Connection" />
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Lbl}" Text="Site URL" VerticalAlignment="Center" />
                                <TextBox x:Name="txtUrl" Grid.Column="1" Style="{StaticResource TB}" LostFocus="CfgField_LostFocus" />
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Lbl}" Text="Username" VerticalAlignment="Center" />
                                <TextBox x:Name="txtLogin" Grid.Column="1" Style="{StaticResource TB}" LostFocus="CfgField_LostFocus" />
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Lbl}" Text="Password" VerticalAlignment="Center" />
                                <TextBox x:Name="txtPwd" Grid.Column="1" Style="{StaticResource TB}" />
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Lbl}" Text="Language" VerticalAlignment="Center" />
                                <TextBox x:Name="txtLang" Grid.Column="1" Style="{StaticResource TB}" />
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Lbl}" Text="Company ID" VerticalAlignment="Center" />
                                <TextBox x:Name="txtCmp" Grid.Column="1" Style="{StaticResource TB}" />
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Lbl}" Text="RM Host" VerticalAlignment="Center" />
                                <TextBox x:Name="txtRm" Grid.Column="1" Style="{StaticResource TB}" />
                            </Grid>
                            <Grid Margin="0,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Lbl}" Text="Version" VerticalAlignment="Center" />
                                <TextBox x:Name="txtVer" Grid.Column="1" Style="{StaticResource TB}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Database Card -->
                    <Border Grid.Column="2" Grid.Row="0" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Hdr}" Text="Database" />
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Lbl}" Text="SQL Server" VerticalAlignment="Center" />
                                <TextBox x:Name="txtSrv" Grid.Column="1" Style="{StaticResource TB}" LostFocus="CfgField_LostFocus" />
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Lbl}" Text="Database" VerticalAlignment="Center" />
                                <TextBox x:Name="txtDb" Grid.Column="1" Style="{StaticResource TB}" LostFocus="CfgField_LostFocus" />
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Lbl}" Text="Backup File" VerticalAlignment="Center" />
                                <TextBox x:Name="txtBak" Grid.Column="1" Style="{StaticResource TB}" LostFocus="CfgField_LostFocus" />
                                <Button Grid.Column="2" Content="Browse" Style="{StaticResource BtnS}" Margin="6,0,0,0" Click="Browse_Click" Tag="bak" />
                                <Button Grid.Column="3" Content="Restore" Style="{StaticResource BtnS}" Margin="6,0,0,0" Click="BtnRestore_Click" />
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Lbl}" Text="Backup Folder" VerticalAlignment="Center" />
                                <TextBox x:Name="txtBakOut" Grid.Column="1" Style="{StaticResource TB}" LostFocus="CfgField_LostFocus" />
                                <Button Grid.Column="2" Content="Browse" Style="{StaticResource BtnS}" Margin="6,0,0,0" Click="Browse_Click" Tag="bakout" />
                            </Grid>
                            <Grid Margin="0,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Lbl}" Text="Backup Mode" VerticalAlignment="Center" />
                                <ComboBox x:Name="cmbBak" Grid.Column="1" Style="{StaticResource CB}">
                                    <ComboBoxItem Content="Always" />
                                    <ComboBoxItem Content="Failed Only" IsSelected="True" />
                                    <ComboBoxItem Content="Never" />
                                </ComboBox>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Paths & Browser Card -->
                    <Border Grid.Column="0" Grid.Row="2" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Hdr}" Text="Paths &amp; Browser" />
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Lbl}" Text="Browser" VerticalAlignment="Center" />
                                <TextBox x:Name="txtBrowser" Grid.Column="1" Style="{StaticResource TB}" Grid.ColumnSpan="2" Margin="4,0,68,0" LostFocus="CfgField_LostFocus" />
                                <Button Grid.Column="2" Content="Browse" Style="{StaticResource BtnS}" Margin="10,0,-4,0" Click="Browse_Click" Tag="browser" />
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Lbl}" Text="RunHeadless " VerticalAlignment="Top" Margin="0,2,10,0" />
                                <CheckBox x:Name="chkHead" Grid.Column="1" Style="{StaticResource Tog}" VerticalAlignment="Center" Margin="4,0,371,0" />
                            </Grid>
                            <Grid Margin="0,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Lbl}" Text="Testproj.exe path" VerticalAlignment="Center" />
                                <TextBox x:Name="txtExe" Grid.Column="1" Style="{StaticResource TB}" Grid.ColumnSpan="2" Margin="4,0,68,0" LostFocus="CfgField_LostFocus" />
                                <Button Grid.Column="2" Content="Browse" Style="{StaticResource BtnS}" Margin="10,0,-4,0" Click="Browse_Click" Tag="exe" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Logging Card -->
                    <Border Grid.Column="2" Grid.Row="2" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Hdr}" Text="Logging" />
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Lbl}" Text="Log Level" VerticalAlignment="Center" />
                                <ComboBox x:Name="cmbLog" Grid.Column="1" Style="{StaticResource CB}">
                                    <ComboBoxItem Content="DEBUG" IsSelected="True" />
                                    <ComboBoxItem Content="INFO" />
                                    <ComboBoxItem Content="WARN" />
                                    <ComboBoxItem Content="ERROR" />
                                </ComboBox>
                                <TextBlock Grid.Column="3" Style="{StaticResource Lbl}" Text="Screenshots" VerticalAlignment="Center" />
                                <ComboBox x:Name="cmbSS" Grid.Column="4" Style="{StaticResource CB}">
                                    <ComboBoxItem Content="true" IsSelected="True" />
                                    <ComboBoxItem Content="false" />
                                </ComboBox>
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Lbl}" Text="Log Folder" VerticalAlignment="Center" />
                                <TextBox x:Name="txtLogDir" Grid.Column="1" Style="{StaticResource TB}" LostFocus="CfgField_LostFocus" />
                                <Button Grid.Column="2" Content="Browse" Style="{StaticResource BtnS}" Margin="6,0,0,0" Click="Browse_Click" Tag="logdir" />
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Lbl}" Text="Screenshot Folder" VerticalAlignment="Center" />
                                <TextBox x:Name="txtPicDir" Grid.Column="1" Style="{StaticResource TB}" LostFocus="CfgField_LostFocus" />
                                <Button Grid.Column="2" Content="Browse" Style="{StaticResource BtnS}" Margin="6,0,0,0" Click="Browse_Click" Tag="picdir" />
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Lbl}" Text="Archive Folder" VerticalAlignment="Center" />
                                <TextBox x:Name="txtArcDir" Grid.Column="1" Style="{StaticResource TB}" LostFocus="CfgField_LostFocus" />
                                <Button Grid.Column="2" Content="Browse" Style="{StaticResource BtnS}" Margin="6,0,0,0" Click="Browse_Click" Tag="arcdir" />
                            </Grid>
                            <Grid Margin="0,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Lbl}" Text="Options" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <CheckBox x:Name="chkDelLog" Style="{StaticResource Tog}" />
                                    <TextBlock Text="Delete old logs" Foreground="{DynamicResource Fg2}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                    <CheckBox x:Name="chkSound" Style="{StaticResource Tog}" />
                                    <TextBlock Text="Sound on done" Foreground="{DynamicResource Fg2}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ═══════════════ TESTS ═══════════════ -->
            <TabItem Header="TESTS" Style="{StaticResource TI}">
                <Grid Margin="20,14,20,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- DLL Picker -->
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Assemblies" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Fg}" Margin="0,0,0,8" />
                            <Grid Grid.Row="1" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button Content="Scan Folder" Style="{StaticResource BtnP}" HorizontalAlignment="Stretch" Click="BtnScan_Click" Padding="10,6" FontSize="12" />
                                <Button Grid.Column="1" Content="+" Style="{StaticResource BtnS}" Margin="4,0,0,0" Click="BtnAddDll_Click" Padding="8,5" FontWeight="Bold" />
                            </Grid>
                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="pnlDlls" />
                            </ScrollViewer>
                            <Button Grid.Row="3" x:Name="btnLoad" Content="Load Selected" Style="{StaticResource BtnP}" Margin="0,8,0,0" Click="BtnLoad_Click" Padding="12,7" FontSize="12" HorizontalAlignment="Stretch" />
                            <TextBlock x:Name="txtDllStat" Grid.Row="4" Margin="0,4,0,0" FontSize="11" Foreground="{DynamicResource Fg3}" TextWrapping="Wrap" />
                        </Grid>
                    </Border>

                    <!-- Test Grid (full width, no right panel) -->
                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Header row -->
                            <Grid Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="txtListTitle" Text="Tests" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Fg}" VerticalAlignment="Center" />
                                    <Border x:Name="badgeDll" Visibility="Collapsed" Background="{StaticResource Warn}" CornerRadius="2" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="DLLs changed" FontSize="10" Foreground="White" />
                                    </Border>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="↻" Style="{StaticResource BtnS}" Click="BtnRefresh_Click" FontSize="14" Padding="5,2" ToolTip="Reload after build" />
                                    <Button Content="All" Style="{StaticResource BtnS}" Margin="4,0,0,0" Click="BtnSelAll_Click" Padding="8,3" FontSize="11" />
                                    <Button Content="None" Style="{StaticResource BtnS}" Margin="4,0,0,0" Click="BtnSelNone_Click" Padding="8,3" FontSize="11" />
                                    <Button x:Name="btnSelFilter" Content="Selected" Style="{StaticResource BtnS}" Margin="4,0,0,0" Click="BtnSelFilter_Click" Padding="8,3" FontSize="11" ToolTip="Show only selected tests" />
                                </StackPanel>
                            </Grid>

                            <!-- Module filter + search -->
                            <Grid Grid.Row="1" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="cmbModule" Style="{StaticResource CB}" Width="180" SelectionChanged="ModuleFilter_Changed">
                                    <ComboBoxItem Content="All Modules" IsSelected="True" />
                                </ComboBox>
                                <TextBox x:Name="txtFilter" Grid.Column="2" Style="{StaticResource TB}" TextChanged="Filter_Changed" />
                            </Grid>

                            <!-- Column headers -->
                            <Grid Grid.Row="2" Margin="0,0,17,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="45" />
                                    <ColumnDefinition Width="65" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="1" Text="Test Name" Foreground="{DynamicResource Fg3}" FontSize="11" Margin="0,0,6,4" />
                                <TextBlock Grid.Column="2" Text="Module" Foreground="{DynamicResource Fg3}" FontSize="11" Margin="6,0,6,4" />
                                <TextBlock Grid.Column="3" Text="Set BP" Foreground="{DynamicResource Fg3}" FontSize="11" Margin="6,0,6,4" />
                                <TextBlock Grid.Column="4" Text="Last Archive" Foreground="{DynamicResource Fg3}" FontSize="11" Margin="6,0,6,4" />
                                <TextBlock Grid.Column="5" Text="Result" Foreground="{DynamicResource Fg3}" FontSize="11" Margin="6,0,6,4" />
                                <TextBlock Grid.Column="6" Text="Logs" Foreground="{DynamicResource Fg3}" FontSize="11" Margin="6,0,6,4" />
                                <TextBlock Grid.Column="7" Text="Duration" Foreground="{DynamicResource Fg3}" FontSize="11" Margin="6,0,0,4" />
                                <!-- Header bottom border -->
                                <Border Grid.ColumnSpan="8" BorderBrush="{DynamicResource Fg3}" BorderThickness="0,0,0,0.5" VerticalAlignment="Bottom" />
                            </Grid>

                            <!-- Test rows (virtualized) -->
                            <ListBox x:Name="lstTests" Grid.Row="3"
                                     Background="Transparent" BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     VirtualizingStackPanel.IsVirtualizing="True"
                                     VirtualizingStackPanel.VirtualizationMode="Recycling"
                                     ScrollViewer.CanContentScroll="True"
                                     HorizontalContentAlignment="Stretch">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <ContentPresenter />
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>

                            <!-- Empty state -->
                            <StackPanel x:Name="pnlEmpty" Grid.Row="3" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Visible">
                                <TextBlock Text="No tests loaded" FontSize="16" Foreground="{DynamicResource Fg3}" HorizontalAlignment="Center" Margin="0,0,0,8" />
                                <TextBlock Text="Use the Assemblies panel to scan a folder and load test DLLs" FontSize="12" Foreground="{DynamicResource Fg3}" HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="300" TextAlignment="Center" />
                            </StackPanel>

                            <TextBlock x:Name="txtStat" Grid.Row="4" Margin="0,4,0,0" FontSize="11" Foreground="{DynamicResource Fg3}" />
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ═══════════════ RESULTS ═══════════════ -->
            <TabItem Header="RESULTS" Style="{StaticResource TI}">
                <Grid Margin="20,14,20,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource Card}" Padding="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="cmbRuns" Style="{StaticResource CB}" SelectionChanged="CmbRuns_Changed" />
                            <Button Grid.Column="2" Content="Load Runs" Style="{StaticResource BtnP}" Click="BtnLoadRuns_Click" Padding="14,6" FontSize="12" />
                            <Button Grid.Column="4" Content="Open Folder" Style="{StaticResource BtnS}" Click="BtnOpenFolder_Click" />
                        </Grid>
                    </Border>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="300" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="380" MinWidth="200" />
                        </Grid.ColumnDefinitions>
                        <!-- Log tree -->
                        <Border Style="{StaticResource Card}" Padding="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid Margin="14,10,14,6">
                                    <TextBlock Text="Execution Log" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Fg}" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock x:Name="txtResStatus" Text="" FontSize="12" FontWeight="SemiBold" Margin="0,0,12,0" VerticalAlignment="Center" />
                                        <TextBlock x:Name="txtResDur" Text="" FontSize="12" Foreground="{DynamicResource Fg2}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                                <TreeView x:Name="treeLog" Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="6,0,6,6" SelectedItemChanged="Tree_Selected" VirtualizingStackPanel.IsVirtualizing="False">
                                    <TreeView.Resources>
                                        <Style TargetType="TreeViewItem">
                                            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
                                            <Setter Property="FontFamily" Value="Arial" />
                                            <Setter Property="FontSize" Value="12" />
                                            <Setter Property="Padding" Value="2,2" />
                                            <Setter Property="IsExpanded" Value="True" />
                                        </Style>
                                    </TreeView.Resources>
                                </TreeView>
                            </Grid>
                        </Border>
                        <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent" Cursor="SizeWE" />
                        <!-- Screenshot -->
                        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Margin="14,10,14,6">
                                    <TextBlock Text="Screenshot" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Fg}" />
                                    <Button x:Name="btnOpenSS" Content="Open" Style="{StaticResource BtnS}" HorizontalAlignment="Right" Padding="8,3" FontSize="10" Click="BtnOpenSS_Click" Visibility="Collapsed" />
                                </Grid>
                                <Border Grid.Row="1" Background="{DynamicResource BgPage}" Margin="6,0,6,0" CornerRadius="2" ClipToBounds="True">
                                    <Grid>
                                        <TextBlock x:Name="txtNoSS" Text="Select a log entry to preview" Foreground="{DynamicResource Fg3}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Padding="16" />
                                        <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
                                            <Image x:Name="imgSS" RenderOptions.BitmapScalingMode="HighQuality" />
                                        </Viewbox>
                                    </Grid>
                                </Border>
                                <TextBlock x:Name="txtSSPath" Grid.Row="2" Margin="14,4,14,8" FontSize="10" Foreground="{DynamicResource Fg3}" TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>
            <!-- ═══════════════ BREAKPOINTS ═══════════════ -->
            <TabItem Header="BREAKPOINTS" Style="{StaticResource TI}">
                <local:BreakpointTab x:Name="BreakpointTabControl" />
            </TabItem>

            <!-- ═══════════════ LINKS ═══════════════ -->
            <TabItem Header="LINKS" Style="{StaticResource TI}">
                <Grid Margin="30,24,30,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- GROUP 1: Environments -->
                    <StackPanel Grid.Row="0">
                        <TextBlock Text="Environments"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Fg3}"
                                   Margin="0,0,0,10"
                                   TextDecorations="Underline"/>
                        <UniformGrid Columns="2" Rows="1">
                            <Button Tag="https://deploy.acumatica.com/"
                                    Click="BtnLink_Click"
                                    Style="{StaticResource LinkCard}"
                                    Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="🚀" FontSize="22" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                    <TextBlock Text="Acumatica Deploy" FontSize="13" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" Foreground="{DynamicResource Fg}"/>
                                    <TextBlock Text="deploy.acumatica.com" FontSize="10"
                                               HorizontalAlignment="Center" Foreground="{DynamicResource Fg3}" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button Tag="https://testportal.acumatica.com/"
                                    Click="BtnLink_Click"
                                    Style="{StaticResource LinkCard}">
                                <StackPanel>
                                    <TextBlock Text="🧪" FontSize="22" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                    <TextBlock Text="Acumatica Test Portal" FontSize="13" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" Foreground="{DynamicResource Fg}"/>
                                    <TextBlock Text="testportal.acumatica.com" FontSize="10"
                                               HorizontalAlignment="Center" Foreground="{DynamicResource Fg3}" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Button>
                        </UniformGrid>
                    </StackPanel>

                    <!-- GROUP 2: Development -->
                    <StackPanel Grid.Row="2">
                        <TextBlock Text="Development"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Fg3}"
                                   Margin="0,0,0,10"
                                   TextDecorations="Underline"/>
                        <UniformGrid Columns="2" Rows="1">
                            <Button Tag="https://jira.acumatica.com/"
                                    Click="BtnLink_Click"
                                    Style="{StaticResource LinkCard}"
                                    Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="📋" FontSize="22" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                    <TextBlock Text="Acumatica Jira" FontSize="13" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" Foreground="{DynamicResource Fg}"/>
                                    <TextBlock Text="jira.acumatica.com" FontSize="10"
                                               HorizontalAlignment="Center" Foreground="{DynamicResource Fg3}" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button Tag="https://bitbucket.acumatica.com/dashboard"
                                    Click="BtnLink_Click"
                                    Style="{StaticResource LinkCard}">
                                <StackPanel>
                                    <TextBlock Text="🔀" FontSize="22" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                    <TextBlock Text="Acumatica Bitbucket" FontSize="13" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" Foreground="{DynamicResource Fg}"/>
                                    <TextBlock Text="bitbucket.acumatica.com" FontSize="10"
                                               HorizontalAlignment="Center" Foreground="{DynamicResource Fg3}" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Button>
                        </UniformGrid>
                    </StackPanel>

                    <!-- GROUP 3: Documentation -->
                    <StackPanel Grid.Row="4">
                        <TextBlock Text="Documentation"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Fg3}"
                                   Margin="0,0,0,10"
                                   TextDecorations="Underline"/>
                        <UniformGrid Columns="2" Rows="1">
                            <Button Tag="https://wiki.acumatica.com/"
                                    Click="BtnLink_Click"
                                    Style="{StaticResource LinkCard}"
                                    Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="📖" FontSize="22" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                    <TextBlock Text="Acumatica Wiki" FontSize="13" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" Foreground="{DynamicResource Fg}"/>
                                    <TextBlock Text="wiki.acumatica.com" FontSize="10"
                                               HorizontalAlignment="Center" Foreground="{DynamicResource Fg3}" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button Tag="https://help.acumatica.com/"
                                    Click="BtnLink_Click"
                                    Style="{StaticResource LinkCard}">
                                <StackPanel>
                                    <TextBlock Text="❓" FontSize="22" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                    <TextBlock Text="Acumatica Help" FontSize="13" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" Foreground="{DynamicResource Fg}"/>
                                    <TextBlock Text="help.acumatica.com" FontSize="10"
                                               HorizontalAlignment="Center" Foreground="{DynamicResource Fg3}" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Button>
                        </UniformGrid>
                    </StackPanel>

                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</Window>
